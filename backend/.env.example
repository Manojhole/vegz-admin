APP_ENV=development
DATABASE_URL=sqlite:///./vegz_admin.db
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
ADMIN_TOKEN_TTL_MINUTES=60
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-password-at-least-14-chars
BOOTSTRAP_ADMIN_NAME=Platform Administrator
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Partner approval callback integration. Set host-reachable URLs for local Docker and HTTPS URLs in production.
PARTNER_ADMIN_TOKEN=replace-with-the-same-random-secret-used-by-shop-and-agent
SHOP_SERVICE_URL=http://host.docker.internal:8002
AGENT_SERVICE_URL=http://host.docker.internal:8001
